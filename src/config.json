          "orientation": "N"
        }
      },
      "gds": [
        "pdk_dir::libs.ref/sg13cmos5l_sram/gds/RM_IHPSG13_1P_1024x32_c2_bm_bist.gds"
      ],
      "lef": [
        "pdk_dir::libs.ref/sg13cmos5l_sram/lef/RM_IHPSG13_1P_1024x32_c2_bm_bist.lef"
      ],
      "nl": [
        "pdk_dir::libs.ref/sg13cmos5l_sram/verilog/RM_IHPSG13_1P_1024x32_c2_bm_bist.v"
      ],
      "lib": {
        "*_typ_1p20V_25C": [
          "pdk_dir::libs.ref/sg13cmos5l_sram/lib/RM_IHPSG13_1P_1024x32_c2_bm_bist_typ_1p20V_25C.lib"
        ],
        "*_fast_1p32V_m40C": [
          "pdk_dir::libs.ref/sg13cmos5l_sram/lib/RM_IHPSG13_1P_1024x32_c2_bm_bist_fast_1p32V_m40C.lib"
        ],
        "*_slow_1p08V_125C": [
          "pdk_dir::libs.ref/sg13cmos5l_sram/lib/RM_IHPSG13_1P_1024x32_c2_bm_bist_slow_1p08V_125C.lib"
        ]
      }
    }
  },

  "PDN_MACRO_CONNECTIONS": [
    "u_emulator.u_sram.u_ihp_sram VDD VSS VDD! VSS!",
    "u_emulator.u_sram.u_ihp_sram VDD VSS VDDARRAY! VSS!"
